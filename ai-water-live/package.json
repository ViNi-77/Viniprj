{
  "name": "ai-water-live",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "トークンの水 — 世界でいま消えている AI の冷却水をトークン単位でリアルタイムに見せる",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
