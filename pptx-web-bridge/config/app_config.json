{
  "_comment": "このアプリの既定値。描画はしないので、寸法・レイアウトの設定は持たない（読み取りと受け渡しだけ）。",
  "server": {
    "host": "127.0.0.1",
    "port": 8765,
    "open_browser": true
  },
  "paths": {
    "logs_dir": "logs"
  },
  "limits": {
    "max_upload_mb": 50,
    "max_slides": 300
  },
  "html_import": {
    "max_columns": 3
  },
  "copilot": {
    "chat_url": "https://m365.cloud.microsoft/chat",
    "max_prompt_chars": 12000
  },
  "logging": {
    "level": "INFO",
    "file_name": "app.log",
    "max_bytes": 2000000,
    "backup_count": 3
  }
}
